```rust
//! Per-core solo survey, all-core contention pass, thermal heatsoak.
//! Usage:
//!   survey [--baseline] [--samples N] [--proxy-limit N] [--heatsoak SECS]
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::{mpsc, Arc, Barrier, Mutex};
use std::time::{Duration, Instant};
use titan_bench::{canary, pin, proxy, snapshot, topology};

struct CoreResult {
    cpu: usize, part: Option<u32>, cluster: &'static str,
    canary: f64, mem: f64, proxy_rate: f64, allcore_rate: f64,
}

fn median3_proxy(limit: u64) -> f64 {
    let mut ts = Vec::new();
    for _ in 0..3 {
        let t = Instant::now();
        let c = proxy::pi_proxy(limit);
        ts.push(t.elapsed());
        std::hint::black_box(c);
    }
    ts.sort();
    limit as f64 / ts[1].as_secs_f64()
}

